.score-page {
  padding-top: var(--space-lg);
  padding-bottom: calc(var(--space-2xl) + 72px + env(safe-area-inset-bottom));
}

.score-game-name {
  font-size: var(--font-section);
  font-weight: 600;
  line-height: 1.25;
  color: var(--color-text);
  overflow-wrap: anywhere;
}

.score-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 44px;
  margin-top: var(--space-lg);
}
.score-section-title-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
  min-width: 0;
}
.score-section-title {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.25;
  color: var(--color-text);
}
.score-section-hint {
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
}
.score-select-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex-shrink: 0;
}
.score-selected-count {
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
}
.score-select-divider {
  color: var(--color-border);
  font-size: 13px;
}
button.score-select-all {
  width: auto;
  min-height: 44px;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 15px;
  font-weight: 600;
}

/* Receiver cards */
.receiver-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-sm);
}
@media (max-width: 359px) {
  .receiver-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
.receiver-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-xs) var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: var(--control-radius);
  background: var(--color-surface);
  box-sizing: border-box;
}
.receiver-card.is-selected {
  border-color: var(--color-primary);
  background: var(--color-primary-subtle);
}
.receiver-check {
  position: absolute;
  top: 6px;
  right: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border: 1.5px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-surface);
  color: #fff;
  font-size: 11px;
}
.receiver-check.is-on {
  border-color: var(--color-primary);
  background: var(--color-primary);
}
.receiver-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 18px;
  font-weight: 600;
  line-height: 48px;
  text-align: center;
}
.receiver-card.is-selected .receiver-avatar {
  background: var(--color-primary);
  color: var(--color-surface);
}
.receiver-name {
  max-width: 100%;
  color: var(--color-text);
  font-size: 13px;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-divider {
  margin-top: var(--space-xl);
  border-top: 1px solid var(--color-border);
}

/* Big amount */
.score-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}
.score-number {
  color: var(--color-primary);
  font-size: 40px;
  font-weight: 600;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}
.score-unit {
  color: var(--color-primary);
  font-size: var(--font-body);
  font-weight: 500;
}

/* Preset chips */
.quick-scores-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}
button.quick-score-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 0;
  border: 1px solid var(--color-border);
  border-radius: var(--control-radius);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: var(--font-body);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
button.quick-score-btn.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
  font-weight: 600;
}

/* Change preview */
.score-preview-summary {
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
  text-align: right;
}
.change-preview {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-top: var(--space-sm);
  overflow-x: auto;
}
.change-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex-shrink: 0;
}
.change-separator {
  width: 1px;
  height: 40px;
  flex-shrink: 0;
  background: var(--color-border);
}
.change-avatar {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 15px;
  font-weight: 600;
  line-height: 40px;
  text-align: center;
}
.change-info {
  min-width: 0;
}
.change-name {
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 72px;
}
.change-value {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}
.change-value.positive { color: var(--color-score-positive); }
.change-value.negative { color: var(--color-score-negative); }

/* Numeric keypad */
.num-pad {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
  margin-top: var(--space-xl);
}
button.pad-key {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 52px;
  padding: 0;
  border: 1px solid var(--color-border);
  border-radius: var(--control-radius);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 18px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
button.pad-key:active {
  background: var(--color-primary-subtle);
}
button.pad-key-text {
  color: var(--color-text-secondary);
  font-size: 15px;
}
.pad-backspace {
  font-size: 18px !important;
}

/* Feedback */
.feedback-banner {
  margin-top: var(--space-lg);
  padding: var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: var(--control-radius);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
}
.feedback-banner.success {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
.feedback-banner.error {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

/* Fixed submit */
.submit-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: var(--space-md) var(--page-inset) calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1px solid var(--color-border);
  box-sizing: border-box;
}
button.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 52px;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--control-radius);
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--font-body);
  font-weight: 600;
}
button.submit-button:active {
  background: var(--color-primary-pressed);
}
button.submit-button[disabled] {
  color: var(--color-text-secondary);
  background: var(--color-border);
}
