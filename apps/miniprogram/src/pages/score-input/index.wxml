<view class="page score-page">
  <view class="score-game-name">{{gameName}}</view>

  <!-- Receiver selection -->
  <view class="score-section-head score-receiver-head">
    <view class="score-section-title-row">
      <view class="score-section-title">我给谁记分?</view>
      <view class="score-section-hint">可多选</view>
    </view>
    <view class="score-select-actions">
      <text class="score-selected-count">已选{{selectedCount}}人</text>
      <text class="score-select-divider">|</text>
      <button class="score-select-all" bindtap="toggleAll" hover-class="tap-feedback">{{allSelected ? '取消全选' : '全选'}}</button>
    </view>
  </view>

  <view class="receiver-grid">
    <view
      wx:for="{{receivers}}"
      wx:key="id"
      data-id="{{item.id}}"
      class="receiver-card {{item.selected ? 'is-selected' : ''}}"
      bindtap="toggleReceiver"
      hover-class="tap-feedback"
    >
      <view class="receiver-content">
        <view class="receiver-avatar">{{item.initial}}</view>
        <view class="receiver-name">{{item.displayName}}</view>
      </view>
    </view>
  </view>

  <!-- Per-person amount -->
  <view class="score-divider" />
  <view class="score-section-head">
    <view class="score-section-title-row">
      <view class="score-section-title">每人分数</view>
    </view>
  </view>
  <view class="score-display">
    <text class="score-number">{{scoreText}}</text>
    <text class="score-unit">分</text>
  </view>

  <view class="quick-scores-row">
    <button
      wx:for="{{presetScores}}"
      wx:key="*this"
      class="quick-score-btn {{scoreText == item ? 'is-active' : ''}}"
      data-value="{{item}}"
      bindtap="quickScore"
      hover-class="tap-feedback"
    >{{item}}</button>
  </view>

  <!-- Numeric keypad -->
  <view class="num-pad">
    <button wx:for="{{numKeys}}" wx:key="*this" class="pad-key" data-value="{{item}}" bindtap="pressKey" hover-class="tap-feedback">{{item}}</button>
    <button class="pad-key pad-key-text" data-value="clear" bindtap="pressKey" hover-class="tap-feedback">清空</button>
    <button class="pad-key" data-value="0" bindtap="pressKey" hover-class="tap-feedback">0</button>
    <button class="pad-key" data-value="backspace" bindtap="pressKey" hover-class="tap-feedback" aria-label="删除一位">
      <text class="iconfont pad-backspace">{{icons.deleteLeft}}</text>
    </button>
  </view>

  <view wx:if="{{feedbackMessage}}" class="feedback-banner {{feedbackTone}}">
    {{feedbackMessage}}
  </view>

  <view class="submit-dock">
    <view wx:if="{{summaryText}}" class="submit-summary">{{summaryText}}</view>
    <button
      class="submit-button"
      disabled="{{!canSubmit || submitting}}"
      bindtap="submit"
      hover-class="tap-feedback"
    >
      {{submitText}}
    </button>
  </view>
</view>
