<view class="page join-page {{fontClass}}">
  <view class="join-intro">
    <view class="join-brand"><image class="brand-mark" src="/images/home/suits.png" mode="aspectFit" aria-hidden="true" /><text class="brand-name">一局一分</text></view>
    <view class="join-title">加入这局，和朋友一起</view>
    <view class="join-description">先确认牌局信息，再设置你在局内的显示名称。</view>
  </view>

  <view wx:if="{{game}}" class="game-section">
    <view class="field-label">即将加入</view>
    <view class="game-name">{{game.name}}</view>
    <view class="game-meta">进行中 · {{game.participantText}} 人 · 房主 {{game.creatorName}}</view>
    <view class="game-meta">牌友：{{participantSummary}}{{participants.length > 4 ? ' 等' + participants.length + '人' : ''}}</view>
  </view>

  <view class="name-section">
    <view class="name-label-row">
      <view class="field-label">我的显示名称</view>
      <view class="name-counter">{{nameLength}}/12</view>
    </view>
    <view class="name-control {{nameFocused ? 'is-focused' : ''}}">
      <input class="name-input" value="{{displayName}}" bindinput="onNameInput" bindfocus="onNameFocus" bindblur="onNameBlur" focus="{{nameFocused}}" disabled="{{joining || joined}}" placeholder="牌局里怎么称呼你" placeholder-class="name-placeholder" maxlength="12" confirm-type="done" cursor-spacing="24" aria-label="我的显示名称，最多12字" />
      <button wx:if="{{nameLength > 0}}" class="clear-name" bindtap="clearName" disabled="{{joining || joined}}" hover-class="control-pressed" aria-label="清空显示名称"><icon type="clear" size="16" color="#68716D" /></button>
    </view>
    <view class="name-tip">名称在牌局内必须唯一</view>
  </view>

  <view wx:if="{{conflictGame}}" class="conflict-warning" role="alert">
    <block wx:if="{{conflictGame.canLeave}}">
      你当前已在另一牌局“{{conflictGame.name}}”中。确认加入当前牌局将自动退出原牌局。
    </block>
    <block wx:else>
      你当前已在另一牌局“{{conflictGame.name}}”中且累计分值不为0。必须将分值清零并退出后，才能加入新牌局。
    </block>
  </view>

  <view class="join-actions">
    <button
      class="join-button {{joined ? 'is-joined' : ''}}"
      bindtap="submit"
      loading="{{joining}}"
      hover-class="join-pressed"
      disabled="{{joining || joined || (conflictGame && !conflictGame.canLeave)}}"
    >
      <block wx:if="{{joining}}">正在加入</block>
      <block wx:elif="{{joined}}">已成功加入</block>
      <block wx:else>{{conflictGame ? '退出原牌局并加入当前牌局' : '确认加入当前牌局'}}</block>
    </button>
    <button class="cancel-button" bindtap="cancel" hover-class="cancel-pressed">取消</button>
  </view>
</view>
