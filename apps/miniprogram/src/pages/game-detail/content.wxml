<view class="page detail-page {{isPublicShare ? 'public-share-page' : ''}} {{isHome ? 'home-detail ' + fontClass : ''}}">
  <view wx:if="{{isHome}}" class="brand"><image class="brand-mark" src="/images/home/suits.png" aria-hidden="true" /><text class="brand-name">一局一分</text></view>
  <!-- Topbar (settled / non-active views only; active view uses the big-title header) -->
  <view wx:if="{{!isPublicShare && game.status !== 'active'}}" class="detail-topbar">
    <view wx:if="{{!isHome}}" style="width: 76rpx;"></view>
    <view class="detail-title">
      <view>{{game.name}}</view>
      <text>{{game.createdAtText}}</text>
    </view>
    <view style="width: 76rpx;"></view>
  </view>

  <!-- ACTIVE MODE UI -->
  <block wx:if="{{game.status === 'active'}}">
    <!-- Game identity: big title + single QR action -->
    <view class="game-identity">
      <view class="game-name">{{game.name}}</view>
      <button class="game-qr-button" bindtap="showInvite" hover-class="tap-feedback" aria-label="邀请加入牌局">
        <image wx:if="{{isHome}}" class="game-qr-icon" src="/images/home/qr.png" aria-hidden="true" />
        <text wx:else class="iconfont game-qr-icon">{{icons.qrCode}}</text>
      </button>
    </view>

    <!-- Status meta -->
    <view class="game-meta">
      <view class="game-meta-line">
        <view class="status-dot" />
        <text>进行中 · {{participantCount}}人 · {{scoreTransferCount}}笔计分</text>
      </view>
      <view wx:if="{{elapsedText}}" class="game-meta-sub">已进行 {{elapsedText}}</view>
    </view>

    <!-- Pending Finish Request Banner -->
    <view wx:if="{{pendingFinishRequest}}" class="finish-request-banner card">
      <block wx:if="{{game.isCreator}}">
        <view class="finish-banner-title">“{{pendingFinishRequest.requestedByName}}”申请结束本局</view>
        <view class="finish-banner-actions">
          <button class="finish-banner-btn approve" bindtap="approveFinish">确认结束</button>
          <button class="finish-banner-btn reject" bindtap="rejectFinish">拒绝</button>
        </view>
      </block>
      <block wx:else>
        <view class="finish-pending-text">
          <text class="iconfont inline-icon animate-pulse">{{icons.history}}</text>
          正在等待创建者确认结束（由 {{pendingFinishRequest.requestedByName}} 发起）...
        </view>
      </block>
    </view>

    <!-- Round Warning Banner -->
    <view wx:if="{{roundStatus && roundStatus.pendingPlayerNames.length > 0 && transfers.length > 0}}" class="round-warning-banner card">
      <view class="round-warning-text">
        <text class="iconfont inline-icon animate-pulse" style="margin-right: var(--space-responsive-xs); color: #ba1a1a;">{{icons.info}}</text>
        本轮（第{{roundStatus.roundNo}}局）还有 {{uninvolvedNamesText}} 尚未计分/被计分。
      </view>
    </view>

    <!-- Scoreboard -->
    <view class="section-head">
      <view class="section-title">当前比分</view>
      <view class="section-unit">分</view>
    </view>
    <view class="score-list">
      <view wx:for="{{participants}}" wx:key="id" class="score-row" bindtap="{{item.isMe ? 'renameSelf' : ''}}">
        <view class="score-rank">{{index + 1}}</view>
        <view class="score-avatar">{{item.initial}}</view>
        <view class="score-player">
          <view class="score-player-name">{{item.name}}</view>
          <view wx:if="{{item.isMe}}" class="score-player-self">我</view>
        </view>
        <view class="score-value {{item.scoreTone}}">{{item.score}}</view>
      </view>
    </view>

    <!-- Primary scoring entry -->
    <button class="button-primary score-entry" bindtap="inputScore" hover-class="tap-feedback" disabled="{{participants.length < 2}}">
      <text class="iconfont button-icon">{{icons.edit}}</text>
      记一笔
    </button>
    <view wx:if="{{participants.length < 2}}" class="scoring-hint">至少两位参与者加入后可以计分</view>
  </block>

  <!-- SETTLED MODE UI -->
  <block wx:else>
    <block wx:if="{{isPublicShare}}">
      <view class="public-share-hero">
        <view class="public-brand">一局一分</view>
        <view class="public-title">{{game.name}}</view>
        <view class="public-meta">{{game.createdAtText}} 已结算</view>
      </view>

      <view class="public-scoreboard card">
        <view class="public-card-head">
          <view>
            <view class="public-card-kicker">公开结算</view>
            <view class="public-card-title">最终分值</view>
          </view>
          <view class="public-readonly-badge">只读</view>
        </view>

        <view class="public-player-list">
          <view wx:for="{{participants}}" wx:key="id" class="public-player-row">
            <view class="public-player-left">
              <view class="public-rank">{{index + 1}}</view>
              <view class="public-player-name">{{item.name}}</view>
            </view>
            <view class="public-score {{item.scoreTone}}">{{item.score}}</view>
          </view>
        </view>
      </view>

      <button class="button-primary public-entry-button" bindtap="enterMiniProgram" hover-class="tap-feedback">
        进入一局一分
      </button>
    </block>

    <block wx:else>
      <view class="section-row">
      <view class="section-label" style="color: #ba1a1a;">已结算 (只读)</view>
      <view class="settled-badge" style="background: rgba(186, 26, 26, 0.1); color: #ba1a1a; font-size: 22rpx; font-weight: bold; padding: var(--space-legacy-4rpx) var(--space-responsive-sm); border-radius: 8rpx;">零和已冻结</view>
      </view>

      <!-- All Historical Participants Section -->
      <view class="participant-list card" style="border-top: 4rpx solid #ba1a1a;">
        <view wx:for="{{participants}}" wx:key="id" class="participant-row">
          <view class="person">
            <view class="avatar-wrap">
              <view class="avatar" style="background: #efeeeb; color: #6f7976;">{{item.initial}}</view>
            </view>
            <view>
              <view class="person-name">{{item.name}}</view>
              <view class="person-role" style="color: #6f7976;">最终分值</view>
            </view>
          </view>
          <view class="score {{item.scoreTone}}">{{item.score}}</view>
        </view>
      </view>

      <!-- Save settlement poster with Mini Program code -->
      <button class="button-primary score-entry" bindtap="saveSettlementPoster" disabled="{{isSavingPoster}}" style="background: #1f695d; box-shadow: 0 12rpx 34rpx rgba(31, 105, 93, 0.16);">
        {{isSavingPoster ? '正在生成图片...' : '保存结算图片'}}
      </button>
    </block>
  </block>

  <!-- Recent Score Transfers -->
  <view wx:if="{{!isPublicShare}}" class="section-head">
    <view class="section-title">{{game.status === 'active' ? '最近计分' : '计分明细'}}</view>
    <button wx:if="{{game.status === 'active' && transfers.length > 3}}" class="section-link" bindtap="toggleTransfers" hover-class="tap-feedback">
      {{showAllTransfers ? '收起' : '全部明细'}}
      <text class="iconfont section-link-icon">{{showAllTransfers ? icons.chevronUp : icons.chevronRight}}</text>
    </button>
  </view>

  <view wx:if="{{!isPublicShare}}" class="transfer-list">
    <view wx:for="{{visibleTransfers}}" wx:key="id" class="transfer-row-wrap">
      <view wx:if="{{item.canReverse && swipedTransferId === item.id}}" class="transfer-row-actions">
        <button class="transfer-row-action" catchtap="onReverseTransfer" data-transfer-id="{{item.id}}">撤销</button>
      </view>
      <view
        class="transfer-row {{item.reversedAt ? 'transfer-row-muted' : ''}} {{swipedTransferId === item.id ? 'is-swiped' : ''}}"
        style="{{swipeDragId === item.id ? 'transform: translateX(' + swipeDragX + 'px);' + (swipeDragging ? 'transition: none;' : '') : ''}}"
        data-id="{{item.id}}"
        bindtap="onTransferRowTap"
        bindtouchstart="onTransferRowTouchStart"
        bindtouchmove="onTransferRowTouchMove"
        bindtouchend="onTransferRowTouchEnd"
        bindtouchcancel="onTransferRowTouchCancel"
      >
        <view class="transfer-row-time">{{item.shortTime}}</view>
        <view class="transfer-row-main">
          <view class="transfer-row-headline">{{item.headline}}</view>
          <view wx:if="{{item.subLabel}}" class="transfer-row-sub">
            {{item.subLabel}}<text class="transfer-row-after {{item.senderChange.afterTone}}">{{item.changeLine}}</text>
          </view>
          <view wx:if="{{item.isReversal}}" class="transfer-row-sub">原计分：{{item.originalText}}</view>
          <view wx:if="{{item.isReversal}}" class="reversal-changes">
            <view wx:for="{{item.scoreChanges}}" wx:key="playerId" wx:for-item="change" class="reversal-change-row">
              <text class="reversal-change-name">{{change.playerName}}</text>
              <text class="reversal-change-values">{{change.beforeText}} → </text>
              <text class="reversal-change-after {{change.afterTone}}">{{change.afterText}}</text>
              <text class="reversal-change-effect {{change.effectTone}}">{{change.effectText}}</text>
            </view>
          </view>
          <view wx:if="{{item.reversedAt}}" class="transfer-row-sub">此笔计分已由撤销记录冲回</view>
        </view>
        <view class="transfer-row-side">
          <view wx:if="{{item.amountLabel}}" class="transfer-row-amount">{{item.amountLabel}}</view>
          <view wx:if="{{item.deltaLabel}}" class="transfer-row-delta">{{item.deltaLabel}}</view>
          <view wx:if="{{item.isReversal || item.reversedAt}}" class="transfer-row-status">已撤销</view>
        </view>
      </view>
    </view>
    <view wx:if="{{transfers.length === 0}}" class="transfer-empty">
      暂无计分记录
    </view>
    <view wx:if="{{isLoadingTransfers}}" class="transfer-loading">加载中…</view>
  </view>

  <!-- Bottom quiet actions -->
  <view wx:if="{{!isPublicShare}}" class="quiet-actions">
    <button wx:if="{{isHome && game.status === 'finished'}}" class="quiet-action" bindtap="refreshHome">返回牌局</button>
    <block wx:if="{{game.status === 'active'}}">
      <button wx:if="{{game.isCreator}}" class="quiet-action" bindtap="finish" hover-class="tap-feedback">
        <text class="iconfont quiet-action-icon">{{icons.checkSquare}}</text>
        结束本局
      </button>
      <block wx:else>
        <button wx:if="{{isHome}}" class="quiet-action" bindtap="exitGame" hover-class="tap-feedback">退出牌局</button>
        <button class="quiet-action" bindtap="finish" hover-class="tap-feedback">申请结束</button>
      </block>
    </block>
  </view>

  <!-- Invite QR overlay -->
  <view wx:if="{{showInviteOverlay}}" class="invite-overlay" bindtap="hideInvite">
    <view class="invite-popup" catchtap="none">
      <view class="invite-popup-header">
        <view class="invite-popup-title">微信扫码加入</view>
        <button class="invite-close-btn" bindtap="hideInvite" hover-class="invite-close-pressed" aria-label="关闭">
          <view class="invite-close-icon" aria-hidden="true"></view>
        </button>
      </view>
      <view class="invite-qr-area">
        <view wx:if="{{isLoadingJoinCode}}" class="invite-qr-loading">正在生成小程序码…</view>
        <image wx:else class="qr-image" src="{{qrCodeUrl}}" mode="aspectFit" aria-label="加入牌局的小程序码"></image>
      </view>
      <view class="invite-popup-hint">用微信扫一扫小程序码<text class="invite-hint-line">进入加入页，与朋友一起记分</text></view>
    </view>
  </view>

  <canvas wx:if="{{game.status === 'finished' && !isPublicShare}}" canvas-id="settlementPoster" class="poster-canvas"></canvas>
</view>
