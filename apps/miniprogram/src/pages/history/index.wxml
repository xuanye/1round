<view class="page history-page {{fontClass}}">
  <view wx:if="{{isLoading && items.length === 0}}" class="page-state" role="status">正在加载历史牌局…</view>
  <view wx:elif="{{error && items.length === 0}}" class="page-state" role="alert">
    <view>{{error}}</view>
    <button class="retry-button" hover-class="row-pressed" bindtap="retry">重新加载</button>
  </view>
  <block wx:else>
    <empty-state wx:if="{{items.length === 0}}" text="暂无历史牌局" />
    <view wx:else class="history-list">
      <view wx:for="{{items}}" wx:key="id" class="history-row" data-id="{{item.id}}" bindtap="open" hover-class="row-pressed" role="button" aria-label="{{item.name}}，我的得分{{item.scoreLabel}}">
        <view class="history-main">
          <view class="history-name">{{item.name}}</view>
          <view class="history-meta">{{item.meta}}</view>
        </view>
        <text class="list-score {{item.scoreTone}} {{item.scoreLabel.length > 7 ? 'compact-score' : ''}}"><text wx:if="{{item.myFinalScore !== 0}}" class="score-sign">{{item.myFinalScore > 0 ? '+' : '−'}}</text><text>{{item.myFinalScore < 0 ? -item.myFinalScore : item.myFinalScore}}</text></text>
        <view class="chevron" aria-hidden="true" />
      </view>
    </view>
    <view wx:if="{{isLoading}}" class="list-status" role="status">加载中…</view>
    <view wx:elif="{{!hasMore && items.length > 0}}" class="list-status">已显示全部历史牌局</view>
  </block>
</view>
