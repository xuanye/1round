<view wx:if="{{homeState === 'loading'}}" class="page home-status {{fontClass}}">正在加载牌局…</view>
<view wx:elif="{{homeState === 'error'}}" class="page home-status {{fontClass}}">
  <view>{{homeError}}</view>
  <button class="home-button primary" hover-class="primary-pressed" bindtap="refreshHome">重新加载</button>
</view>
<block wx:elif="{{id}}"><include src="../game-detail/content.wxml" /></block>
<view wx:else class="page home-page tab-page {{fontClass}}">
  <view class="brand"><image class="brand-mark" src="/images/home/suits.png" aria-hidden="true" /><text class="brand-name">一局一分</text></view>
  <view class="home-hero">
    <view class="hero-copy"><view class="hero-title">来一局，记下好时光</view><view class="hero-description">和朋友一起，轻松记分。</view></view>
    <image class="hero-art" src="/images/home/playing-cards.png" mode="aspectFit" aria-hidden="true" />
  </view>
  <view class="game-status"><view class="status-dot" /><text>尚无进行中的牌局</text></view>
  <view class="home-actions">
    <button class="home-button primary" hover-class="primary-pressed" bindtap="scanToJoin"><image class="action-icon" src="/images/home/scan.png" aria-hidden="true" /><text>扫码加入牌局</text></button>
    <button class="home-button secondary" hover-class="secondary-pressed" bindtap="createGame"><image class="action-icon" src="/images/home/plus.png" aria-hidden="true" /><text>创建牌局</text></button>
  </view>
  <view class="recent-section">
    <view class="section-head"><view class="section-title">最近牌局</view><button class="history-link" hover-class="tap-feedback" bindtap="history">全部记录<view class="chevron" /></button></view>
    <button wx:if="{{recentError}}" class="recent-empty retry-link" bindtap="loadRecentGames">{{recentError}}</button>
    <view wx:elif="{{recentGames.length === 0}}" class="recent-empty">暂无历史牌局</view>
    <view wx:else class="recent-list">
      <view wx:for="{{recentGames}}" wx:key="id" class="recent-row {{item.score.length > 7 ? 'large-score' : ''}}" data-id="{{item.id}}" bindtap="openRecent" hover-class="row-pressed" role="button" aria-label="{{item.title}}，我的分值{{item.score}}">
        <view class="recent-main"><view class="recent-title">{{item.title}}</view><view class="recent-meta">{{item.meta}}</view></view>
        <text class="recent-score {{item.scoreTone}}">{{item.score}}</text>
      </view>
    </view>
  </view>
</view>
