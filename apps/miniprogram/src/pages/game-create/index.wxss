.create-page { padding: var(--space-xl) var(--page-inset) calc(var(--space-xl) + env(safe-area-inset-bottom)); color: var(--color-text); }
.create-intro { text-align: center; }
.create-brand { display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); }
.brand-mark { width: 32px; height: 32px; }
.brand-name { color: var(--color-primary); font-size: var(--font-section); font-weight: 600; line-height: 1.25; }
.create-title { margin-top: var(--space-lg); font-size: var(--font-heading); font-weight: 600; line-height: 1.25; }
.create-description { margin-top: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; }
.name-section { margin-top: var(--space-xl); }
.field-label { font-size: 18px; font-weight: 600; line-height: 1.25; }
.name-label-row { display: flex; align-items: baseline; justify-content: space-between; }
.name-control { display: flex; align-items: center; min-height: 52px; margin-top: var(--space-sm); padding-left: var(--space-md); border: 1px solid var(--color-text-secondary); border-radius: var(--control-radius); background: var(--color-surface); box-sizing: border-box; }
.name-control.is-focused { border-color: var(--color-primary); outline: 2px solid var(--color-primary); outline-offset: 2px; }
.name-input { flex: 1; min-width: 0; height: 48px; padding-right: var(--space-sm); color: var(--color-text); font-size: var(--font-body); line-height: 1.5; }
.name-placeholder { color: var(--color-text-secondary); }
button.clear-name { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex-shrink: 0; margin: 0 var(--space-xs) 0 0; border-radius: var(--control-radius); background: transparent; }
.name-counter { color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; font-variant-numeric: tabular-nums; }
.suggestion-label { margin-top: var(--space-md); color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; }
.name-suggestions { display: flex; gap: var(--space-xs); margin-top: var(--space-xs); }
button.name-suggestion { flex: 1; width: auto; min-width: 0; min-height: 44px; padding: 0 var(--space-xs); display: flex; align-items: center; justify-content: center; border: 1px solid var(--color-border); border-radius: var(--control-radius); color: var(--color-text); background: var(--color-primary-subtle); font-size: var(--font-body); font-weight: 400; line-height: 1.5; box-sizing: border-box; }
button.name-suggestion.is-selected { border-color: var(--color-primary); color: var(--color-primary); }
.control-pressed { background: var(--color-border) !important; }
.preset-section { margin-top: var(--space-lg); padding: var(--space-md) 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
.preset-description { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: 13px; line-height: 1.5; }
.preset-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-sm); margin-top: var(--space-sm); }
button.preset-chip { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 44px; padding: 0; border: 1px solid var(--color-border); border-radius: var(--control-radius); color: var(--color-text); background: var(--color-surface); font-size: var(--font-body); font-weight: 400; line-height: 1.5; box-sizing: border-box; }
button.preset-chip.is-selected { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-primary-subtle); font-weight: 600; }
button.preset-chip[disabled] { opacity: 0.6; }
.create-actions { margin-top: var(--space-xl); }
button.create-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 52px; padding: var(--space-sm) var(--space-md); border-radius: var(--control-radius); color: var(--color-surface); background: var(--color-primary); box-shadow: none; font-size: var(--font-body); font-weight: 600; line-height: 1.5; }
.create-pressed { background: var(--color-primary-pressed) !important; }
button.create-button[disabled] { color: var(--color-text-secondary); background: var(--color-border); }
button.name-suggestion[disabled], button.clear-name[disabled] { opacity: 0.6; }
.create-tips { margin-top: var(--space-sm); color: var(--color-text-secondary); font-size: 13px; line-height: 1.5; text-align: center; }
.create-note { margin-top: var(--space-xs); }
.creation-error { margin-bottom: var(--space-sm); color: var(--color-danger); font-size: var(--font-supporting); line-height: 1.5; overflow-wrap: anywhere; }
