.mine-page {
  padding: var(--space-xl) var(--page-inset) calc(var(--tab-height) + var(--space-xl) + env(safe-area-inset-bottom));
}
.profile {
  display: flex; align-items: center; gap: var(--space-lg);
  padding-bottom: var(--space-xl); border-bottom: 1px solid var(--color-border);
}
.profile-avatar { width: 64px; height: 64px; border-radius: 50%; flex-shrink: 0; }
.avatar-fallback {
  display: flex; align-items: center; justify-content: center;
  background: var(--color-primary-subtle); color: var(--color-primary); font-size: 26px;
}
.profile-identity { flex: 1; min-width: 0; }
.profile-name { font-size: 20px; font-weight: 600; line-height: 1.25; overflow-wrap: break-word; }
.profile-description { margin-top: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; }
.profile-state { min-height: 64px; padding-bottom: var(--space-xl); border-bottom: 1px solid var(--color-border); font-size: var(--font-supporting); line-height: 1.5; color: var(--color-text-secondary); }
.retry-button {
  min-height: 44px !important; margin-top: var(--space-sm); padding: var(--space-sm) var(--space-lg);
  background: transparent; border: 1px solid var(--color-border); border-radius: var(--control-radius);
  color: var(--color-primary); font-size: var(--font-body); font-weight: 500;
}
.menu-section { margin-top: var(--space-2xl); }
.section-heading { margin-bottom: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-supporting); font-weight: 600; line-height: 1.5; }
.menu-row {
  display: flex; align-items: center; gap: var(--space-lg); min-height: 72px !important;
  padding: var(--space-lg) 0; border-bottom: 1px solid var(--color-border); border-radius: 0;
  background: transparent; color: var(--color-text); font-size: var(--font-body); font-weight: 400; line-height: 1.5; text-align: left;
}
.menu-icon { width: 24px; height: 24px; flex-shrink: 0; }
.menu-label { flex: 1; min-width: 0; overflow-wrap: break-word; }
.menu-value { flex-shrink: 0; color: var(--color-text-secondary); font-size: var(--font-supporting); }
.row-chevron { width: 16px; height: 16px; flex-shrink: 0; }
.row-pressed { background: var(--color-primary-subtle); }
.brand-footer { padding-top: var(--space-2xl); text-align: center; }
.brand-signature { display: flex; align-items: center; justify-content: center; gap: var(--space-sm); font-size: var(--font-body); font-weight: 600; color: var(--color-primary); line-height: 1.5; }
.brand-icon { width: 26px; height: 26px; }
.brand-description { margin-top: var(--space-sm); color: var(--color-text-secondary); font-size: 13px; line-height: 1.5; }
