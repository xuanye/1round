.detail-page {
  padding-top: var(--space-lg);
  padding-bottom: var(--space-2xl);
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 926px;
  height: 1800px;
}

.public-share-page {
  padding-top: var(--space-legacy-42rpx);
  padding-bottom: var(--space-legacy-72rpx);
}

.detail-topbar,
.section-row,
.participant-row,
.person {
  display: flex;
}

.detail-topbar {
  position: relative;
  z-index: 5;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  margin: calc(0rpx - var(--space-legacy-20rpx)) calc(0rpx - var(--space-legacy-40rpx)) var(--space-legacy-28rpx);
  padding: var(--space-legacy-20rpx) var(--space-legacy-40rpx);
  background: rgba(250, 249, 246, 0.86);
}



.detail-title {
  min-width: 0;
  max-width: 430rpx;
  text-align: center;
}

.detail-title view {
  color: #1f695d;
  font-size: 36rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-title text {
  display: block;
  color: #3f4946;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-row {
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-legacy-26rpx);
}

.section-label {
  color: #3f4946;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.participant-list {
  margin-top: var(--space-legacy-18rpx);
  overflow: hidden;
}

.participant-row {
  align-items: center;
  justify-content: space-between;
  padding: var(--space-legacy-30rpx);
  border-bottom: 1rpx solid rgba(190, 201, 197, 0.24);
}

.participant-row:last-child {
  border-bottom: 0;
}

.person {
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-wrap {
  position: relative;
  margin-right: var(--space-legacy-22rpx);
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  color: #00332c;
  background: #a9f0e0;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 92rpx;
  text-align: center;
}

.participant-row:nth-child(2) .avatar {
  color: #ffffff;
  background: #29657e;
}

.participant-row:nth-child(3) .avatar {
  color: #2f1400;
  background: #ffdcc4;
}

.star-icon {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  color: #ffffff !important;
  background: #8e4e14;
  font-size: 20rpx !important;
  line-height: 34rpx;
  text-align: center;
  display: block;
}

.person-name {
  min-width: 0;
  color: #1a1c1a;
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-role,
.transfer-time {
  margin-top: var(--space-legacy-6rpx);
  color: #3f4946;
  font-size: 22rpx;
}

.score {
  flex-shrink: 0;
  margin-left: var(--space-legacy-20rpx);
  font-size: 38rpx;
  font-weight: 900;
}

.score.positive { color: #1f695d; }
.score.negative { color: #ba1a1a; }
.score.muted { color: #3f4946; }

.public-share-hero {
  padding: var(--space-legacy-20rpx) 0 var(--space-legacy-30rpx);
}

.public-brand {
  color: #1f695d;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.public-title {
  margin-top: var(--space-legacy-14rpx);
  color: #1a1c1a;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  word-break: break-all;
}

.public-meta {
  margin-top: var(--space-legacy-12rpx);
  color: #6f7976;
  font-size: 24rpx;
  font-weight: 700;
}

.public-scoreboard {
  margin-top: var(--space-responsive-sm);
  overflow: hidden;
  border-radius: 16rpx;
}

.public-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-responsive-lg) var(--space-legacy-34rpx);
  background: #f4f8f6;
  border-bottom: 1rpx solid rgba(190, 201, 197, 0.34);
}

.public-card-kicker {
  color: #1f695d;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.public-card-title {
  margin-top: var(--space-responsive-xs);
  color: #1a1c1a;
  font-size: 34rpx;
  font-weight: 900;
}

.public-readonly-badge {
  padding: var(--space-responsive-xs) var(--space-legacy-18rpx);
  border-radius: 8rpx;
  color: #8e4e14;
  background: rgba(142, 78, 20, 0.12);
  font-size: 22rpx;
  font-weight: 900;
}

.public-player-list {
  padding: var(--space-responsive-xs) var(--space-legacy-34rpx) var(--space-legacy-12rpx);
}

.public-player-row,
.public-player-left {
  display: flex;
  align-items: center;
}

.public-player-row {
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid rgba(190, 201, 197, 0.26);
}

.public-player-row:last-child {
  border-bottom: 0;
}

.public-player-left {
  flex: 1;
  min-width: 0;
}

.public-rank {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  margin-right: var(--space-legacy-22rpx);
  border-radius: 8rpx;
  color: #1f695d;
  background: rgba(31, 105, 93, 0.1);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
}

.public-player-name {
  min-width: 0;
  color: #1a1c1a;
  font-size: 32rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.public-score {
  flex-shrink: 0;
  margin-left: var(--space-legacy-20rpx);
  font-size: 42rpx;
  font-weight: 900;
}

.public-score.positive { color: #1f695d; }
.public-score.negative { color: #ba1a1a; }
.public-score.muted { color: #3f4946; }

button.public-entry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  margin-top: var(--space-responsive-lg);
  font-size: 32rpx;
}

.score-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: var(--space-legacy-30rpx) 0 0;
  height: 108rpx;
  font-size: 36rpx;
  line-height: 1;
  transition: transform 100ms ease;
}

.score-entry:active {
  transform: scale(0.96);
}

.score-entry .button-icon {
  margin-right: var(--space-legacy-12rpx);
  font-size: 40rpx !important;
}

.transfer-list {
  display: flex;
  flex-direction: column;
  margin-top: var(--space-legacy-20rpx);
}
/* Glassmorphism Invite Overlay */
.invite-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--page-inset);
  box-sizing: border-box;
  background: rgba(32, 41, 37, 0.48);
}

.invite-popup {
  width: 320px;
  max-width: 100%;
  box-sizing: border-box;
  background: var(--color-surface);
  border-radius: 16px;
  padding: var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.invite-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  width: 100%;
  margin-bottom: var(--space-lg);
}

.invite-popup-title {
  color: var(--color-text);
  font-size: 20px;
  font-weight: 600;
  line-height: 1.25;
}

.invite-qr-area {
  position: relative;
  width: 100%;
  max-width: 240px;
}

.invite-qr-area::before {
  content: "";
  display: block;
  padding-top: 100%;
}

.qr-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.invite-qr-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 14px;
}

.invite-popup-hint {
  margin-top: var(--space-lg);
  font-size: 13px;
  line-height: 1.5;
  color: var(--color-text-secondary);
  text-align: center;
}

.invite-hint-line {
  display: block;
}

button.invite-close-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  border-radius: var(--control-radius);
  color: var(--color-text-secondary);
  background: transparent;
}

.invite-close-icon {
  position: relative;
  width: 20px;
  height: 20px;
}

.invite-close-icon::before,
.invite-close-icon::after {
  content: "";
  position: absolute;
  top: 9px;
  left: 0;
  width: 20px;
  height: 2px;
  border-radius: 1px;
  background: currentColor;
  transform: rotate(45deg);
}

.invite-close-icon::after {
  transform: rotate(-45deg);
}

.invite-close-pressed {
  background: var(--color-primary-subtle);
}

/* Pending Finish Request Banner */
.finish-request-banner {
  background: #fffbeb;
  border: 1rpx solid #fef3c7;
  border-radius: 28rpx;
  padding: var(--space-legacy-30rpx);
  margin-bottom: var(--space-legacy-30rpx);
}

.finish-banner-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #b45309;
  margin-bottom: var(--space-responsive-sm);
}

.finish-banner-actions {
  display: flex;
  gap: var(--space-legacy-20rpx);
}

button.finish-banner-btn {
  flex: 1;
  width: 100%;
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 18rpx;
  text-align: center;
}

.finish-banner-btn.approve {
  color: #ffffff;
  background: #ba1a1a;
}

.finish-banner-btn.reject {
  color: #3f4946;
  background: #efeeeb;
}

.finish-pending-text {
  font-size: 26rpx;
  color: #b45309;
}



/* Round Warning Banner */
.round-warning-banner {
  background: #fdf2f2;
  border: 1rpx solid #fde8e8;
  border-radius: 28rpx;
  padding: var(--space-legacy-30rpx);
  margin-bottom: var(--space-legacy-30rpx);
}

.round-warning-text {
  font-size: 26rpx;
  color: #ba1a1a;
  line-height: 1.5;
  display: flex;
  align-items: center;
}


/* ===== Active game redesign (DESIGN.md tokens) ===== */

/* Big-title header with single QR action */
.game-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}
.game-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-heading);
  font-weight: 600;
  line-height: 1.25;
  color: var(--color-text);
  overflow-wrap: anywhere;
}
button.game-qr-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  padding: 0;
  border: 1px solid var(--color-border);
  border-radius: var(--control-radius);
  background: transparent;
  color: var(--color-primary);
}
.game-qr-icon {
  width: 24px;
  height: 24px;
  font-size: 22px !important;
  color: var(--color-primary);
}

/* Status meta: 进行中 · N人 · N笔计分 / 已进行 X */
.game-meta {
  margin-top: var(--space-md);
}
.game-meta-line {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  color: var(--color-text);
  font-size: var(--font-supporting);
  line-height: 1.5;
}
.game-meta-line .status-dot {
  width: 8px;
  height: 8px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-primary);
}
.game-meta-sub {
  margin-top: var(--space-xs);
  margin-left: calc(8px + var(--space-sm));
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
}

/* Section heads shared by scoreboard and recent list */
.detail-page .section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 44px;
  margin-top: var(--space-xl);
}
.detail-page .section-title {
  font-size: var(--font-section);
  font-weight: 600;
  line-height: 1.25;
  color: var(--color-text);
}
.section-unit {
  color: var(--color-text-secondary);
  font-size: var(--font-supporting);
  line-height: 1.5;
}
button.section-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-xs);
  width: auto;
  min-width: 88px;
  min-height: 44px;
  flex-shrink: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: var(--font-supporting);
  font-weight: 500;
}
.section-link-icon {
  font-size: 12px !important;
}

/* Scoreboard: rank + avatar + name + right-aligned score, thin dividers */
.score-list {
  border-top: 1px solid var(--color-border);
}
.score-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  min-height: 72px;
  padding: var(--space-lg) 0;
  box-sizing: border-box;
  border-bottom: 1px solid var(--color-border);
}
.score-rank {
  width: 20px;
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-supporting);
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.score-avatar {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 18px;
  font-weight: 500;
  line-height: 44px;
  text-align: center;
}
.score-player {
  flex: 1;
  min-width: 0;
}
.score-player-name {
  color: var(--color-text);
  font-size: var(--font-body);
  font-weight: 500;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.score-player-self {
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
}
.score-value {
  flex-shrink: 0;
  max-width: 45%;
  color: var(--color-text-secondary);
  font-size: var(--font-score);
  font-weight: 600;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
  text-align: right;
  overflow-wrap: anywhere;
}
.score-value.positive { color: var(--color-score-positive); }
.score-value.negative { color: var(--color-score-negative); }
.score-value.muted { color: var(--color-text-secondary); }

/* In-flow primary scoring button */
.button-primary.score-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  width: 100%;
  min-height: 52px;
  margin-top: var(--space-xl);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--control-radius);
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.5;
  box-shadow: none;
}
.button-primary.score-entry:active {
  background: var(--color-primary-pressed);
}
.button-primary.score-entry[disabled] {
  color: var(--color-text-secondary);
  background: var(--color-border);
}
.scoring-hint {
  margin-top: var(--space-sm);
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
  text-align: center;
}

/* Compact recent-scoring rows */
.transfer-list {
  border-top: 1px solid var(--color-border);
}
.transfer-row-wrap {
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid var(--color-border);
}
/* Swipe-revealed undo action, WeChat chat-style */
.transfer-row-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
}
button.transfer-row-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 100%;
  min-height: 72px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: var(--color-danger);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}
/* WeChat's default button ::after draws a 1px box; suppress it. */
button.transfer-row-action::after {
  border: none;
}
.transfer-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-lg) 0;
  background: var(--color-bg);
  transition: transform 0.2s ease;
}
/* Reveal 88px while the action is 72px wide, leaving a 16px gutter
   between row content and the undo button. */
.transfer-row.is-swiped {
  transform: translateX(-88px);
}
.transfer-row-muted .transfer-row-headline,
.transfer-row-muted .transfer-row-amount {
  color: var(--color-text-secondary);
}
.transfer-row-time {
  width: 44px;
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}
.transfer-row-main {
  flex: 1;
  min-width: 0;
}
.transfer-row-headline {
  color: var(--color-text);
  font-size: var(--font-body);
  font-weight: 500;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.transfer-row-sub {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.transfer-row-after {
  font-weight: 600;
}
.transfer-row-after.positive { color: var(--color-score-positive); }
.transfer-row-after.negative { color: var(--color-score-negative); }
.transfer-row-after.muted { color: var(--color-text-secondary); }
.transfer-row-side {
  flex-shrink: 0;
  max-width: 40%;
  text-align: right;
}
.transfer-row-amount {
  color: var(--color-text);
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}
.transfer-row-delta {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: 13px;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}
.transfer-row-status {
  display: inline-block;
  margin-top: var(--space-xs);
  padding: 2px var(--space-sm);
  border-radius: 6px;
  background: var(--color-primary-subtle);
  color: var(--color-text-secondary);
  font-size: 12px;
  line-height: 1.5;
}
.reversal-changes {
  margin-top: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--control-radius);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
}
.reversal-change-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--space-xs);
  font-size: 13px;
  line-height: 1.6;
}
.reversal-change-name {
  color: var(--color-text);
  font-weight: 500;
}
.reversal-change-values {
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}
.reversal-change-after {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.reversal-change-after.positive { color: var(--color-score-positive); }
.reversal-change-after.negative { color: var(--color-score-negative); }
.reversal-change-after.muted { color: var(--color-text-secondary); }
.reversal-change-effect {
  margin-left: auto;
  padding: 0 var(--space-sm);
  border-radius: 6px;
  font-size: 12px;
}
.reversal-change-effect.returned {
  color: var(--color-primary);
  background: var(--color-primary-subtle);
}
.reversal-change-effect.deducted {
  color: var(--color-danger);
  background: var(--color-surface);
}
.transfer-empty,
.transfer-loading {
  padding: var(--space-xl) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-supporting);
  line-height: 1.5;
  text-align: center;
}

/* Quiet bottom actions (no fixed dock) */
.quiet-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--space-lg);
  margin-top: var(--space-xl);
  padding-bottom: var(--space-sm);
}
button.quiet-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  width: auto;
  min-height: 44px;
  padding: 0 var(--space-sm);
  border-radius: var(--control-radius);
