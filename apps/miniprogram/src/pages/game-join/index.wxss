.join-page { padding: var(--space-xl) var(--page-inset) calc(var(--space-xl) + env(safe-area-inset-bottom)); color: var(--color-text); }
.join-intro { text-align: center; }
.join-brand { display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); }
.brand-mark { width: 32px; height: 32px; }
.brand-name { color: var(--color-primary); font-size: var(--font-section); font-weight: 600; line-height: 1.25; }
.join-title { margin-top: var(--space-lg); font-size: var(--font-heading); font-weight: 600; line-height: 1.25; }
.join-description { margin-top: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; }
.game-section { margin-top: var(--space-xl); }
.field-label { font-size: 18px; font-weight: 600; line-height: 1.25; }
.game-name { margin-top: var(--space-sm); font-size: var(--font-section); font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
.game-meta { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; overflow-wrap: anywhere; }
.name-section { margin-top: var(--space-lg); padding: var(--space-md) 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
.name-label-row { display: flex; align-items: baseline; justify-content: space-between; }
.name-control { display: flex; align-items: center; min-height: 52px; margin-top: var(--space-sm); padding-left: var(--space-md); border: 1px solid var(--color-text-secondary); border-radius: var(--control-radius); background: var(--color-surface); box-sizing: border-box; }
.name-control.is-focused { border-color: var(--color-primary); outline: 2px solid var(--color-primary); outline-offset: 2px; }
.name-input { flex: 1; min-width: 0; height: 48px; padding-right: var(--space-sm); color: var(--color-text); font-size: var(--font-body); line-height: 1.5; }
.name-placeholder { color: var(--color-text-secondary); }
button.clear-name { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex-shrink: 0; margin: 0 var(--space-xs) 0 0; border-radius: var(--control-radius); background: transparent; }
.name-counter { color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; font-variant-numeric: tabular-nums; }
.name-tip { margin-top: var(--space-sm); color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; }
.control-pressed { background: var(--color-border) !important; }
button.clear-name[disabled] { opacity: 0.6; }
.conflict-warning { margin-top: var(--space-lg); padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--control-radius); background: var(--color-surface); color: var(--color-danger); font-size: var(--font-supporting); line-height: 1.5; overflow-wrap: anywhere; }
.join-actions { margin-top: var(--space-xl); }
button.join-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 52px; padding: var(--space-sm) var(--space-md); border-radius: var(--control-radius); color: var(--color-surface); background: var(--color-primary); box-shadow: none; font-size: var(--font-body); font-weight: 600; line-height: 1.5; }
.join-pressed { background: var(--color-primary-pressed) !important; }
button.join-button[disabled] { color: var(--color-text-secondary); background: var(--color-border); }
button.join-button.is-joined { color: var(--color-surface); background: var(--color-primary); }
button.cancel-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; margin-top: var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--control-radius); color: var(--color-primary); background: transparent; font-size: var(--font-body); font-weight: 600; line-height: 1.5; }
.cancel-pressed { background: var(--color-primary-subtle) !important; }
