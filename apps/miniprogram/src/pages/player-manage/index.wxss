.form-page { display: flex; flex-direction: column; gap: var(--space-responsive-md); }
input { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12rpx; padding: var(--space-responsive-md); }

button.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 1;
  margin: var(--space-legacy-56rpx) 0 var(--space-responsive-md);
}
