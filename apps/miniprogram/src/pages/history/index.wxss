.history-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--space-xl) var(--page-inset) calc(var(--space-xl) + env(safe-area-inset-bottom));
  color: var(--color-text);
}

.history-list {
  border-top: 1px solid var(--color-border);
}

.history-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  min-height: 72px;
  box-sizing: border-box;
  padding: var(--space-md) 0;
  border-bottom: 1px solid var(--color-border);
}

.history-main {
  flex: 1;
  min-width: 0;
}

.history-name {
  font-size: var(--font-body);
  font-weight: 500;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.history-meta {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-supporting);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.list-score {
  flex-shrink: 0;
  max-width: 48%;
  color: var(--color-text-secondary);
  font-size: var(--font-score);
  font-weight: 600;
  line-height: 1.25;
  text-align: right;
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
}

.list-score.positive { color: var(--color-score-positive); }
.list-score.negative { color: var(--color-score-negative); }
.list-score.compact-score { font-size: 18px; }

/* Keep the sign quieter than the digits, matching the ranking page. */
.score-sign { font-size: 85%; vertical-align: baseline; }

.chevron {
  flex-shrink: 0;
  width: 7px;
  height: 7px;
  margin-right: var(--space-legacy-2px);
  border-top: 1.5px solid var(--color-text-secondary);
  border-right: 1.5px solid var(--color-text-secondary);
  transform: rotate(45deg);
}

.page-state,
.list-status {
  padding: var(--space-xl) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-supporting);
  line-height: 1.5;
  text-align: center;
}

.list-status { padding: var(--space-lg) 0; }

.retry-button {
  width: auto !important;
  min-height: 44px !important;
  margin: var(--space-md) auto 0;
  padding: var(--space-sm) var(--space-lg);
  border: 1px solid var(--color-primary);
  border-radius: var(--control-radius);
  background: transparent;
  color: var(--color-primary);
  font-size: var(--font-body);
  font-weight: 500;
}

.row-pressed { background: var(--color-primary-subtle); }
