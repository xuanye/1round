.performance-page { padding: var(--space-lg) var(--page-inset) calc(var(--tab-height) + var(--space-xl) + env(safe-area-inset-bottom)); min-height: 100vh; }
.overview-heading, .section-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
.page-title { font-size: 26px; font-weight: 600; line-height: 1.25; }
.period-control { min-height: 44px; display: flex; align-items: center; gap: var(--space-sm); padding: 0 var(--space-md); background: #EFEEEA; color: var(--color-text-secondary); font-size: var(--font-supporting); border-radius: var(--control-radius); }
.dropdown-icon { font-size: 12px; }
.date-range { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-supporting); }
.metrics { display: grid; grid-template-columns: 1.5fr 1fr .85fr 1.2fr; align-items: center; margin: var(--space-lg) 0; }
.metric { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); border-left: 1px solid var(--color-border); padding: 0 var(--space-xs); }
.metric:first-child { border: 0; padding-left: 0; }
.metric-value { max-width: 100%; font-size: 24px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.2; overflow-wrap: anywhere; }
.metric-main .metric-value { font-size: 40px; }
.metric-label { color: var(--color-text-secondary); font-size: 13px; white-space: nowrap; }
.performance-section { border-top: 1px solid var(--color-border); padding-top: var(--space-lg); margin-top: var(--space-lg); }
.section-title { font-size: var(--font-section); font-weight: 600; line-height: 1.25; }
.trend-canvas { display: block; margin-top: var(--space-md); }
.section-head .section-link { width: auto; min-height: 44px; display: flex; align-items: center; justify-content: flex-end; gap: var(--space-sm); padding-left: var(--space-sm); font-size: var(--font-supporting); color: var(--color-text-secondary); font-weight: 400; background: transparent; border-radius: 0; flex-shrink: 0; }
.chevron { font-size: 12px; color: var(--color-text-secondary); }
.friend-row { display: flex; align-items: center; min-height: 52px; box-sizing: border-box; gap: var(--space-md); padding: var(--space-xs) var(--space-sm); margin-left: calc(0px - var(--space-sm)); margin-right: calc(0px - var(--space-sm)); }
.friend-me { background: var(--color-primary-subtle); }
.rank-number { width: 16px; flex-shrink: 0; color: var(--color-text-secondary); font-size: 20px; font-weight: 500; font-variant-numeric: tabular-nums; }
.rank-0 { color: var(--color-score-positive); }
.rank-1 { color: var(--color-primary); }
.friend-avatar { width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: var(--color-primary); background: var(--color-primary-subtle); font-size: 16px; }
.friend-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-body); }
.list-score { font-size: 24px; font-weight: 600; font-variant-numeric: tabular-nums; flex-shrink: 0; text-align: right; max-width: 48%; overflow-wrap: anywhere; }
.positive { color: var(--color-score-positive); }
.negative { color: var(--color-score-negative); }
.zero { color: var(--color-text-secondary); }
.recent-description { color: var(--color-text-secondary); font-size: var(--font-supporting); margin-bottom: var(--space-xs); }
.history-row { display: flex; align-items: center; min-height: 72px; gap: var(--space-md); padding: var(--space-sm) 0; box-sizing: border-box; border-bottom: 1px solid var(--color-border); }
.history-row:last-child { border-bottom: 0; }
.history-main { flex: 1; min-width: 0; }
.history-name { font-size: var(--font-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-meta { margin-top: var(--space-xs); color: var(--color-text-secondary); font-size: var(--font-supporting); }
.section-empty, .page-state { padding: var(--space-xl) 0; color: var(--color-text-secondary); font-size: var(--font-supporting); line-height: 1.5; }
.retry-button { width: auto !important; min-height: 44px !important; margin-top: var(--space-md); padding: var(--space-sm) var(--space-lg); border: 1px solid var(--color-primary); border-radius: var(--control-radius); background: transparent; color: var(--color-primary); font-size: var(--font-body); }
.row-pressed { opacity: .7; }
.metric-value.compact-score, .metric-main .metric-value.compact-score, .list-score.compact-score { font-size: 18px; }
@media (max-width: 350px) { .metric-main .metric-value { font-size: 32px; } .metric-value { font-size: 20px; } .metric-label { font-size: 12px; } .friend-row { gap: var(--space-sm); } }

/* Keep both signs quieter than the digits, including compact scores. */
.score-sign { font-size: 85%; vertical-align: baseline; }
