<view class="page create-page {{fontClass}}">
  <view class="create-intro">
    <view class="create-brand"><image class="brand-mark" src="/images/home/suits.png" mode="aspectFit" aria-hidden="true" /><text class="brand-name">一局一分</text></view>
    <view class="create-title">开一局，和朋友一起</view>
    <view class="create-description">创建后，邀请牌友加入即可开始记分。</view>
  </view>
  <view class="name-section">
    <view class="name-label-row">
      <view class="field-label">牌局名称</view>
      <view class="name-counter">{{nameLength}}/12</view>
    </view>
    <view class="name-control {{nameFocused ? 'is-focused' : ''}}">
      <input class="name-input" value="{{name}}" bindinput="onNameInput" bindfocus="onNameFocus" bindblur="onNameBlur" focus="{{nameFocused}}" disabled="{{submitting}}" placeholder="给这次相聚起个名字" placeholder-class="name-placeholder" maxlength="12" confirm-type="done" cursor-spacing="24" aria-label="牌局名称，最多12字" />
      <button wx:if="{{nameLength > 0}}" class="clear-name" bindtap="clearName" disabled="{{submitting}}" hover-class="control-pressed" aria-label="清空牌局名称"><icon type="clear" size="16" color="#68716D" /></button>
    </view>
    <view class="suggestion-label">也可以选一个</view>
    <view class="name-suggestions"><button wx:for="{{suggestedNames}}" wx:key="*this" class="name-suggestion {{name === item ? 'is-selected' : ''}}" data-name="{{item}}" bindtap="selectSuggestedName" disabled="{{submitting}}" hover-class="control-pressed" aria-label="使用名称{{item}}">{{item}}</button></view>
  </view>
  <view class="preset-section">
    <view class="field-label">牌局常用分值</view>
    <view class="preset-description">记分时可快捷选择，最多选 4 个，牌友共享这组分值。</view>
    <view class="preset-grid">
      <button wx:for="{{presetOptions}}" wx:key="value" class="preset-chip {{item.selected ? 'is-selected' : ''}}" data-value="{{item.value}}" bindtap="togglePresetScore" disabled="{{submitting}}" hover-class="control-pressed" aria-label="常用分值{{item.value}}{{item.selected ? '，已选中' : '，未选中'}}">{{item.value}}</button>
    </view>
  </view>
  <view class="create-actions">
    <view wx:if="{{creationError}}" class="creation-error" role="alert">{{creationError}}</view>
    <button class="create-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}" hover-class="create-pressed">{{submitting ? '正在创建' : '创建牌局'}}</button>
    <view class="create-tips">
      <view>创建后你将自动加入本局，通过二维码邀请牌友</view>
      <view class="create-note">创建成功后进入牌局，等待牌友加入。</view>
    </view>
  </view>
</view>
